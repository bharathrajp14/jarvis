# Environment variables & secrets
.env
.env.*
!.env.template
config/api_keys.json
credentials.json
config/credentials.json
token.json
token.pickle
*.key
.jarvis/*.key

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Caches & tools
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/

# Runtime data & transient storage
runtime/
runtime/logs/
runtime/captures/
runtime/reports/
runtime/temporary/
runtime/state/
runtime/artifacts/
memory_db/
.jarvis/
*.pid
.jarvis.pid
.jarvis_server.pid

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
%SystemDrive%/

# Virtual environments
venv/
.venv/
env/

# Database files
*.sqlite3
*.db
*.db-wal
*.db-shm

# Build artifacts & packaging outputs
build/
dist/
*.egg-info/
*.spec

# Logs & temporary files
logs/
*.log
scratch/
captures/
reports/
BR_WORKSPACE/

# Office / export artifacts in root
*.xlsx
*.docx
*.pdf

# Guardian runtime state
.guardian_hashes.json
guardian/PAUSED

# Native compiled binaries
native/*.dll
native/*.so
native/*.dylib
src/brjarvis/native/*.dll
src/brjarvis/native/*.so
src/brjarvis/native/*.dylib

# Browser profiles
workspace/browser_user_data/
runtime/browser_user_data/
src/brjarvis/workspace/browser_user_data/

