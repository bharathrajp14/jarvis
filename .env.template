# JARVIS MK37 — Environment Configuration
# ============================================
# Only GEMINI_API_KEY is REQUIRED.
# All other keys are optional enhancements.
# ============================================

# ── REQUIRED: Google Gemini API Key (Direct Google AI Studio) ─────
# Required for all AI completions, embeddings, and planning
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_LISTEN_API_KEY=your_google_gemini_api_key_here

# ── OPTIONAL: OpenAI Proxy Gateway (Local Proxy Gateway) ──────────
# Optional proxy gateway for LLM Chat & Reasoning
OPENAI_BASE_URL=http://127.0.0.1:8045/v1
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gemini-2.5-flash

# Mistral AI (fast, multilingual)
# MISTRAL_API_KEY=

# NVIDIA NIM (GPU-accelerated)
# NVIDIA_API_KEY=

# Ollama (100% local, offline AI)
# OLLAMA_HOST=http://localhost:11434

# ── OPTIONAL: Model Overrides ─────────────────────────────
# JARVIS_MODEL_GEMINI=gemini-3.5-flash
# JARVIS_MODEL_CLAUDE=claude-sonnet-4-20250514
# JARVIS_DEFAULT_BACKEND=gemini

# ── OPTIONAL: Voice Settings ──────────────────────────────
JARVIS_WAKE_WORD="hey jarvis"
JARVIS_WHISPER_MODEL="base.en"           # Whisper model: tiny.en | base.en | small.en
JARVIS_ENABLE_SOUND_EFFECTS=true        # Soft acoustic chimes for wake word & STT feedback
JARVIS_ENABLE_BARGE_IN=true            # Interrupt TTS when user speaks (VAD-based, MK38)
# JARVIS_VOICE_RATE="+30%"             # TTS speed (e.g. +10%, +30%)
# JARVIS_MIC_RECOVERY=true             # Auto-reconnect on mic disconnect (hot-plug recovery)
# JARVIS_MIC_STALE_SECONDS=5          # Seconds of silence before hot-plug watchdog triggers
# JARVIS_AUDIO_INPUT_DEVICE=           # Force specific mic by name/index (empty = auto-detect)

# ── OPTIONAL: Permission Mode ─────────────────────────────
# allow_all | confirm_destructive (default) | confirm_all
# JARVIS_PERMISSION_MODE=confirm_destructive


# ── OPTIONAL: Tool Deny List ──────────────────────────────
# Comma-separated tool names to block
# JARVIS_DENY_TOOLS=restart,shutdown

# ── OPTIONAL: Unsafe Shell Actions (disabled by default) ──
# Allows custom command action type "run_command" to execute raw shell strings.
# JARVIS_ALLOW_UNSAFE_SHELL=false

# ── OPTIONAL: Intent Engine Toggle ────────────────────────────────
# Set to 'false' to disable 0-token deterministic matchers (route all to AI)
# Default: true (50+ fast intent matchers active)
# JARVIS_INTENT_ENGINE_ENABLED=true

# ══════════════════════════════════════════════════════════════════════
# 🔌 JARVIS CONNECTOR HUB — Free Multi-Source Plugin System
# ══════════════════════════════════════════════════════════════════════
# These connectors work WITHOUT a Claude subscription.
# All use free APIs or zero-auth public services.
# Only add the keys for services you want to use.
#
# ── ZERO-SETUP Connectors (work immediately, no config needed) ──────
#   ✅ Wikipedia        — public API, no key
#   ✅ Weather          — Open-Meteo, no key  
#   ✅ DuckDuckGo       — instant answers, no key
#   ✅ RSS News         — BBC, TechCrunch, HackerNews, Reuters (no key)
#   ✅ Local Filesystem — reads your files (no key)
#
# ── API KEY Connectors (free accounts, 2-5 min setup each) ──────────

# GitHub (search repos, issues, PRs, code)
# Get free PAT: github.com → Settings → Developer Settings → PAT (classic)
# Required scopes: repo (read), issues (read)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# YouTube (search videos, channel info, transcripts)
# Get free key: console.cloud.google.com → Enable "YouTube Data API v3"
# Free quota: 10,000 units/day
# Note: video transcript fetching works WITHOUT this key (pip install youtube-transcript-api)
# YOUTUBE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Notion (search pages, read content, query databases)
# Get free integration token: notion.so → Settings → Connections → Develop integrations
# Then share your pages with the integration (click Share → Invite → your integration)
# NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Slack (read channels, search messages, post messages)
# Create free Slack app: api.slack.com → Create App → Install to Workspace
# Required OAuth scopes: channels:read, channels:history, search:read, chat:write
# SLACK_BOT_TOKEN=xoxb-xxxxxxxxxx-xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# Tavily Web Search (richer search results than DuckDuckGo, free tier)
# Get free API key: tavily.com → Sign up (no credit card)
# Free tier: 1,000 searches/month
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── MCP Server Proxy (connect to any MCP-compatible server) ─────────
# Connect JARVIS to any external MCP server (Claude marketplace compatible)
# Format: comma-separated URLs. Optionally prefix with "name=url"
# Local MCP servers: npx @modelcontextprotocol/server-filesystem
#                    npx @modelcontextprotocol/server-github
#                    npx @modelcontextprotocol/server-sqlite
# MCP_SERVER_URLS=http://localhost:3000,http://localhost:3001
# MCP_SERVER_URLS=gdrive=http://localhost:3000,filesystem=http://localhost:3001
